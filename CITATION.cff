cff-version: 1.2.0
message: "If you use the Oikos DSL in your work, please cite the software as below."
type: software
title: "Oikos: a typed DSL for stock-flow consistent macroeconomic modelling"
authors:
  - family-names: "Jewell"
    given-names: "Jonathan D. A."
    email: "j.d.a.jewell@open.ac.uk"
repository-code: "https://github.com/hyperpolymath/oikos-economics-accounting-dsl"
