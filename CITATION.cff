license: MPL-2.0
# `version` and `date-released` are deliberately absent: the crate versions in
# Cargo.toml are still `0.1.0-dev` and nothing has been tagged. CFF makes both
# fields optional; a fabricated `0.1.0 / <today>` pair would assert a release
# that does not exist. Add them in the release commit that tags v0.1.0.
keywords:
  - "stock-flow-consistent"
  - "macroeconomics"
  - "domain-specific-language"
  - "linear-types"
  - "rust"
  - "rsr"
  - "provenance"
