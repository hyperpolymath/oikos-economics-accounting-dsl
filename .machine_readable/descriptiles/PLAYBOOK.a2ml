#
# PLAYBOOK.a2ml — Operational playbook
[metadata]
version = "0.1.0"
last-updated = "2026-04-11"

[deployment]
# method = "gitops"  # gitops | manual | ci-triggered
# target = "container"  # container | binary | library | wasm

[incident-response]
# 1. Check .machine_readable/descriptiles/STATE.a2ml for current status
# 2. Review recent commits and CI results
# 3. Run `just all` to format-check, lint, build, and test
# 4. Run `just audit` and `just secret-scan-trufflehog` for security checks

[release-process]
# 1. Update version in STATE.a2ml, META.a2ml
# 2. Run `just all`, `just audit`, and `just reuse-check`
# 3. Tag and push

[maintenance-operations]
# Baseline audit: just all
# Hard release gate: just all && just audit && just reuse-check
