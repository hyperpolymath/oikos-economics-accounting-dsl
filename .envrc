#
# .envrc — direnv entry point (https://direnv.net/). `direnv allow` once per
# clone; every later `cd` into the repo then provisions the same toolchain the
# CI images use, instead of whatever the shell happened to have.
#
# Both blocks are guarded: a developer without mise or Guix gets a clean
# environment rather than an error on every directory change.

# Load the mise toolchain declared in mise.toml (+ mise.lock once generated).
if has mise; then
  use mise
fi

# Load the Guix development shell when Guix is present. Same manifest as the
# dev shell, so the two provisioning routes cannot disagree about versions.
if has guix && [ -f build/manifest.scm ]; then
  use guix -m build/manifest.scm
fi

# Project environment variables. Non-secret only — a .envrc is committed.
export PROJECT_NAME="oikos-economics-accounting-dsl"

# Real secrets belong in .env (gitignored), never here.
if [ -f .env ]; then
  dotenv .env
fi
